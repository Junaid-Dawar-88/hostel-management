generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Warden {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  rooms     Room[]
  students  Student[]
  menuItems MenuItem[]
}

model Room {
  id        Int       @id @default(autoincrement())
  number    String
  floor     Int
  capacity  Int
  wardenId  Int
  warden    Warden    @relation(fields: [wardenId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  students  Student[]

  @@unique([wardenId, number])
}

model MenuItem {
  id        Int      @id @default(autoincrement())
  day       String
  meal      String
  items     String
  wardenId  Int
  warden    Warden   @relation(fields: [wardenId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wardenId, day, meal])
}

model Student {
  id         Int      @id @default(autoincrement())
  rollNo     String
  name       String
  fatherName String?
  address    String?
  phone      String?
  guardPhone String?
  cnic       String?
  imageUrl   String?
  email      String?
  course     String?
  feeTotal   Float?
  feePaid    Float    @default(0)
  roomId     Int?
  wardenId   Int
  warden     Warden   @relation(fields: [wardenId], references: [id], onDelete: Cascade)
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([wardenId, rollNo])
}
